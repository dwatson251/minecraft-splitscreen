#!/bin/bash
# Minecraft splitscreen for the Steam Deck: one window (what Game Mode / gamescope shows) holding a nested KWin that
# tiles 1-4 Minecraft clients, one per controller.
#   MinecraftSplitscreen.AppImage            start
#   MinecraftSplitscreen.AppImage --setup    (re)create the Prism instances and offline accounts, then exit
# P1 starts alone and asks how many players (Players: N on its title screen changes it later); this script starts
# or stops P2-P4 to match. P1 opens any world, which is shared on LAN; the others join it automatically.
# Controllers are matched to players automatically by the glue mod, including ones plugged in later.
# Logs: ~/.local/state/mc-splitscreen/
set -u
HERE=$(dirname "$(readlink -f "$0")")
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/mc-splitscreen
PRISM_APP=org.prismlauncher.PrismLauncher
PRISM=${MCSS_PRISM_DIR:-$HOME/.var/app/$PRISM_APP/data/PrismLauncher}
SOCKET=mcss-wayland-0
mkdir -p "$STATE"
exec >> "$STATE/apprun.log" 2>&1
log() { echo "[mcss $(date +%T)] $*"; }

prism_running() { flatpak ps --columns=application 2>/dev/null | grep -qx "$PRISM_APP"; }

if prism_running; then
	log "Prism Launcher is already open: close it first (its windows can't be moved into the splitscreen)."
	command -v notify-send >/dev/null && notify-send "Minecraft Splitscreen" "Close Prism Launcher first."
	exit 1
fi

if [ "${1:-}" = --setup ] || [ ! -d "$PRISM/instances/P4" ]; then
	"$HERE/mcss-setup.sh" "$HERE/mods" || exit 1
	[ "${1:-}" = --setup ] && exit 0
fi

# the player count P1 picks; cleared so every session starts with the question
CONTROL=$PRISM/mcss-control
mkdir -p "$CONTROL" && rm -f "$CONTROL/players"
log "start (Steam: ${SteamGamepadUI:+Game Mode}${SteamGamepadUI:-no}; SDL ignore list from Steam: ${SDL_GAMECONTROLLER_IGNORE_DEVICES:--})"

MSA=$(python3 -c 'import json,sys
a=json.load(open(sys.argv[1]))["accounts"]
print(next((x["profile"]["name"] for x in a if x.get("type")=="MSA" and x.get("profile")), ""))' "$PRISM/accounts.json")
[ -n "$MSA" ] || { log "no Microsoft account in Prism Launcher"; exit 1; }

# --- nested KWin, isolated from the user's own KDE config and D-Bus ---
KW=$STATE/kwin
rm -rf "$KW" && mkdir -p "$KW/config" "$KW/data/kwin/scripts"
cp -r "$HERE/kwin/mcss-tile" "$KW/data/kwin/scripts/"
cat > "$KW/config/kwinrc" <<CFG
[Plugins]
mcss-tileEnabled=true
[Compositing]
LatencyPolicy=Low
[Windows]
FocusPolicy=ClickToFocus
CFG
W=${MCSS_WIDTH:-1280}; H=${MCSS_HEIGHT:-800}
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${SteamGamepadUI:-}" ]; then
	BACKEND=(--wayland-display "$WAYLAND_DISPLAY")   # Desktop Mode: a window on Plasma
else
	BACKEND=(--x11-display "${DISPLAY:-:0}")         # Game Mode: a window on gamescope's Xwayland
	if command -v xdpyinfo >/dev/null; then
		read -r W H < <(xdpyinfo -display "${DISPLAY:-:0}" | sed -n 's/.*dimensions: *\([0-9]*\)x\([0-9]*\).*/\1 \2/p' | head -1)
	fi
fi
rm -f "$XDG_RUNTIME_DIR/$SOCKET" "$XDG_RUNTIME_DIR/$SOCKET.lock"
env -u LD_PRELOAD XDG_CONFIG_HOME="$KW/config" XDG_DATA_HOME="$KW/data" QT_FORCE_STDERR_LOGGING=1 \
	dbus-run-session -- kwin_wayland "${BACKEND[@]}" --width "$W" --height "$H" --socket "$SOCKET" \
	> "$STATE/kwin.log" 2>&1 &
KWIN=$!
for _ in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/$SOCKET" ] && break; sleep 0.2; done
[ -S "$XDG_RUNTIME_DIR/$SOCKET" ] || { log "nested KWin did not start, see $STATE/kwin.log"; kill "$KWIN"; exit 1; }
log "nested KWin pid $KWIN on $SOCKET (${W}x${H}, ${BACKEND[0]})"

teardown() {
	trap - EXIT INT TERM HUP
	log "stopping"
	prism_running && flatpak kill "$PRISM_APP"
	kill "$KWIN" 2>/dev/null
	wait "$KWIN" 2>/dev/null
	exit 0
}
trap teardown EXIT INT TERM HUP

# --- clients: SDL3 goes to the nested compositor over Wayland; no X11 so nothing escapes to gamescope ---
# Controllers: under Steam, games get Steam Input's virtual pads (all named "Steam Controller", indistinguishable,
# so the Deck ended up driving several players) and Steam hides the real devices. The clients instead ignore the
# virtual pads (Valve 28de:11ff) and read the real devices, as outside Steam. Steam's 32-bit overlay preload only
# spams errors in the 64-bit children. Prism (Qt) is pinned to Wayland: Game Mode's session sets
# QT_QPA_PLATFORM=xcb, and X11 is hidden from the clients.
PAD_ENV=(SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF SDL_JOYSTICK_IGNORE_DEVICES=0x28DE/0x11FF)
prism() {
	env -u DISPLAY -u LD_PRELOAD -u SteamVirtualGamepadInfo -u SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT \
		WAYLAND_DISPLAY="$SOCKET" SDL_VIDEODRIVER=wayland QT_QPA_PLATFORM=wayland "${PAD_ENV[@]}" \
		flatpak run --env=WAYLAND_DISPLAY="$SOCKET" --env=SDL_VIDEODRIVER=wayland --env=QT_QPA_PLATFORM=wayland \
		--unset-env=DISPLAY \
		--unset-env=LD_PRELOAD --unset-env=SteamVirtualGamepadInfo --unset-env=SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT \
		"${PAD_ENV[@]/#/--env=}" "$PRISM_APP" "$@" >> "$STATE/prism.log" 2>&1 &
}
mc_pid() {  # the Java process of instance P$1, if running
	local p
	for p in $(pgrep -x java); do
		tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q "/instances/P$1/" && { echo "$p"; return; }
	done
}

prism -l P1 -a "$MSA"
for _ in $(seq 120); do [ -n "$(mc_pid 1)" ] && break; sleep 1; done
[ -n "$(mc_pid 1)" ] || { log "P1 did not start, see $STATE/prism.log"; exit 1; }
log "P1 java pid $(mc_pid 1)"

# --- match the running guests to the count P1 picks, until P1 quits or the compositor goes away ---
declare -A LAUNCHED=()   # player -> when its launch was requested (a client takes a while to show up as java)
LAST_LAUNCH=0
while kill -0 "$KWIN" 2>/dev/null && [ -n "$(mc_pid 1)" ]; do
	want=$(cat "$CONTROL/players" 2>/dev/null)
	[[ "$want" =~ ^[1-4]$ ]] || want=1
	now=$(date +%s)
	for n in 2 3 4; do
		pid=$(mc_pid "$n")
		if [ "$n" -le "$want" ] && [ -z "$pid" ]; then
			# one launch at a time: loading several clients at once starves the Deck's 4 cores
			if [ $((now - ${LAUNCHED[$n]:-0})) -gt 120 ] && [ $((now - LAST_LAUNCH)) -ge "${MCSS_STAGGER:-8}" ]; then
				log "starting P$n (players: $want)"
				prism -l "P$n" -a "Player$n"
				LAUNCHED[$n]=$now; LAST_LAUNCH=$now
			fi
		elif [ "$n" -gt "$want" ] && [ -n "$pid" ]; then
			log "stopping P$n (players: $want), java pid $pid"
			kill "$pid"
			LAUNCHED[$n]=0
		elif [ -n "$pid" ]; then
			LAUNCHED[$n]=0
		fi
	done
	sleep 2
done
