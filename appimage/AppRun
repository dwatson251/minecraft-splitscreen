#!/bin/bash
# Minecraft splitscreen for the Steam Deck: one window (what Game Mode / gamescope shows) holding a nested KWin that
# tiles 1-4 Minecraft clients, one per controller.
#   MinecraftSplitscreen.AppImage            start
#   MinecraftSplitscreen.AppImage --setup    (re)create the Prism instances and offline accounts, then exit
#   MinecraftSplitscreen.AppImage --no-update   don't look for a newer version on GitHub
# P1 starts alone with "Press START to play": every controller that presses START becomes the next player (first
# = P1), also later in game, and this script starts that player's view (P2-P4). A guest that quits frees its
# place. P1 opens any world, which is shared on LAN; the others join it automatically.
# Logs: ~/.local/state/mc-splitscreen/
set -u
ARGS=("$@")   # kept for restarting into an update
HERE=$(dirname "$(readlink -f "$0")")
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/mc-splitscreen
PRISM_APP=org.prismlauncher.PrismLauncher
PRISM=${MCSS_PRISM_DIR:-$HOME/.var/app/$PRISM_APP/data/PrismLauncher}
SOCKET=mcss-wayland-0
mkdir -p "$STATE"
exec >> "$STATE/apprun.log" 2>&1
log() { echo "[mcss $(date +%T)] $*"; }

prism_running() { flatpak ps --columns=application 2>/dev/null | grep -qx "$PRISM_APP"; }

if prism_running; then
	log "Prism Launcher is already open: close it first (its windows can't be moved into the splitscreen)."
	command -v notify-send >/dev/null && notify-send "Minecraft Splitscreen" "Close Prism Launcher first."
	exit 1
fi

# every launch: creates the instances the first time, and afterwards puts this AppImage's mods in them, so an
# updated AppImage takes effect without a separate --setup
"$HERE/mcss-setup.sh" "$HERE/mods" || exit 1
[ "${1:-}" = --setup ] && exit 0

# custom skins: ~/Documents/Minecraft Skins (easy to reach from Desktop Mode) mirrored to where the Prism flatpak
# can read them; profiles themselves live in $PRISM/mcss-profiles and are kept
SKINS_SRC="$HOME/Documents/Minecraft Skins"
mkdir -p "$SKINS_SRC" "$PRISM/mcss-skins"
find "$PRISM/mcss-skins" -maxdepth 1 -type f -name '*.png' | while read -r f; do
	[ -f "$SKINS_SRC/$(basename "$f")" ] || rm -f "$f"
done
find "$SKINS_SRC" -maxdepth 1 -type f -iname '*.png' -exec cp -u {} "$PRISM/mcss-skins/" \;
log "skins: $(find "$PRISM/mcss-skins" -maxdepth 1 -name '*.png' | wc -l) custom"

# files the clients share (joined players, pad events, guest heartbeats); emptied so every session starts fresh
CONTROL=$PRISM/mcss-control
mkdir -p "$CONTROL" && rm -f "$CONTROL"/*
STEAM_IGNORED=${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}
log "start (Game Mode: ${SteamGamepadUI:-no}; Steam app: ${SteamAppId:-none}; Steam's SDL ignore list: $(tr ',' '\n' <<< "$STEAM_IGNORED" | grep -c .) devices, replaced)"

MSA=$(python3 -c 'import json,sys
a=json.load(open(sys.argv[1]))["accounts"]
print(next((x["profile"]["name"] for x in a if x.get("type")=="MSA" and x.get("profile")), ""))' "$PRISM/accounts.json")
[ -n "$MSA" ] || { log "no Microsoft account in Prism Launcher"; exit 1; }

# --- nested KWin, isolated from the user's own KDE config and D-Bus ---
start_kwin() {
	KW=$STATE/kwin
	rm -rf "$KW" && mkdir -p "$KW/config" "$KW/data/kwin/scripts"
	cp -r "$HERE/kwin/mcss-tile" "$KW/data/kwin/scripts/"
	cat > "$KW/config/kwinrc" <<-CFG
	[Plugins]
	mcss-tileEnabled=true
	[Compositing]
	LatencyPolicy=Low
	[Windows]
	FocusPolicy=ClickToFocus
	CFG
	W=${MCSS_WIDTH:-1280}; H=${MCSS_HEIGHT:-800}
	# Desktop Mode outside Steam: a Wayland window on Plasma. Under Steam it's an X11 window instead, even on Plasma:
	# Steam only applies the game's controller layout to a window it can see (it's an X11 client), otherwise it uses
	# its desktop layout, which turns every pad's A into Enter, B into Escape, the D-pad into arrow keys.
	if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${SteamGamepadUI:-}" ] && [ -z "${SteamAppId:-}" ]; then
		BACKEND=(--wayland-display "$WAYLAND_DISPLAY")   # Desktop Mode: a window on Plasma
	else
		BACKEND=(--x11-display "${DISPLAY:-:0}")         # Game Mode (gamescope's Xwayland), or Steam on Plasma
		if command -v xdpyinfo >/dev/null; then
			read -r W H < <(xdpyinfo -display "${DISPLAY:-:0}" | sed -n 's/.*dimensions: *\([0-9]*\)x\([0-9]*\).*/\1 \2/p' | head -1)
		fi
	fi
	rm -f "$XDG_RUNTIME_DIR/$SOCKET" "$XDG_RUNTIME_DIR/$SOCKET.lock"
	env -u LD_PRELOAD XDG_CONFIG_HOME="$KW/config" XDG_DATA_HOME="$KW/data" QT_FORCE_STDERR_LOGGING=1 \
		dbus-run-session -- kwin_wayland "${BACKEND[@]}" --width "$W" --height "$H" --socket "$SOCKET" \
		> "$STATE/kwin.log" 2>&1 &
	SESSION=$!   # dbus-run-session; it doesn't pass signals on, so KWin itself is tracked and stopped by its own PID
	for _ in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/$SOCKET" ] && break; sleep 0.2; done
	KWIN=$(pgrep -P "$SESSION" -x kwin_wayland | head -1)
	if [ ! -S "$XDG_RUNTIME_DIR/$SOCKET" ] || [ -z "$KWIN" ]; then
		log "nested KWin did not start, see $STATE/kwin.log"
		[ -n "$KWIN" ] && kill "$KWIN"
		kill "$SESSION" 2>/dev/null
		exit 1
	fi
	log "nested KWin pid $KWIN on $SOCKET (${W}x${H}, ${BACKEND[0]})"
}
# restarting into an update keeps the same nested KWin (MCSS_KWIN="<kwin pid> <dbus-run-session pid>"), so the
# screen stays up and says "Restarting" instead of dropping back to Steam
read -r KWIN SESSION <<< "${MCSS_KWIN:-}"
if [ -n "${KWIN:-}" ] && kill -0 "$KWIN" 2>/dev/null && [ -S "$XDG_RUNTIME_DIR/$SOCKET" ]; then
	log "continuing in nested KWin pid $KWIN"
else
	start_kwin
fi
unset MCSS_KWIN

declare -A LOADING=()   # player -> its loading window's pid (loading_open, below)
stop_session() {
	trap - EXIT INT TERM HUP
	prism_running && flatpak kill "$PRISM_APP"
	for n in "${!LOADING[@]}"; do loading_close "$n"; done
	# a leftover KWin keeps the window open, and Steam would think the game is still running
	kill "$KWIN" 2>/dev/null
	wait "$SESSION" 2>/dev/null
	kill -0 "$KWIN" 2>/dev/null && { sleep 2; kill -KILL "$KWIN" 2>/dev/null; }
}
teardown() {
	log "stopping"
	stop_session
	exit 0
}
trap teardown EXIT INT TERM HUP

# --- clients: SDL3 goes to the nested compositor over Wayland; no X11 so nothing escapes to gamescope ---
# Controllers: under Steam, games get Steam Input's virtual pads (all named "Steam Controller", indistinguishable,
# so the Deck ended up driving several players) and Steam hides the real devices. The clients instead ignore the
# virtual pads (Valve 28de:11ff) and read the real devices, as outside Steam. Steam's 32-bit overlay preload only
# spams errors in the 64-bit children. Prism (Qt) is pinned to Wayland: Game Mode's session sets
# QT_QPA_PLATFORM=xcb, and X11 is hidden from the clients.
# Steam also sets SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD=1, which lets its virtual pads past any ignore
# list: the Deck then showed up twice (itself and its virtual pad), and one START joined two players.
PAD_ENV=(SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF SDL_JOYSTICK_IGNORE_DEVICES=0x28DE/0x11FF
	SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD=0)
prism() {
	env -u DISPLAY -u LD_PRELOAD -u SteamVirtualGamepadInfo -u SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT \
		WAYLAND_DISPLAY="$SOCKET" SDL_VIDEODRIVER=wayland QT_QPA_PLATFORM=wayland "${PAD_ENV[@]}" \
		flatpak run --env=WAYLAND_DISPLAY="$SOCKET" --env=SDL_VIDEODRIVER=wayland --env=QT_QPA_PLATFORM=wayland \
		--unset-env=DISPLAY \
		--unset-env=LD_PRELOAD --unset-env=SteamVirtualGamepadInfo --unset-env=SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT \
		"${PAD_ENV[@]/#/--env=}" "$PRISM_APP" "$@" >> "$STATE/prism.log" 2>&1 &
}
mc_pid() {  # the Java process of instance P$1, if running
	local p
	for p in $(pgrep -x java); do
		tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q "/instances/P$1/" && { echo "$p"; return; }
	done
}

# a player's tile while their Minecraft starts, Player 1's at launch and a guest's when they join (loading.qml, else
# zenity): titled like their game window, "P<n> Loading", so the tiler gives it that player's place at once and
# swaps in the game window when it appears
loading_open() {  # instance, shown number, [status file shown live below the title]
	loading_close "$1"
	local run=(env -u DISPLAY -u LD_PRELOAD WAYLAND_DISPLAY="$SOCKET" QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland
		QT_WAYLAND_DISABLE_WINDOWDECORATION=1 QML_XHR_ALLOW_FILE_READ=1)
	if command -v qml6 >/dev/null; then
		"${run[@]}" qml6 "$HERE/loading.qml" -- "$2" ${3:+"$3"} >> "$STATE/loading.log" 2>&1 &
	elif command -v zenity >/dev/null; then
		local text="Player $2 is joining: starting Minecraft..."
		[ "$2" = 1 ] && text="Minecraft is loading..."
		"${run[@]}" zenity --progress --pulsate --no-cancel --title="P$2 Loading" --text="$text" \
			>> "$STATE/loading.log" 2>&1 &
	else
		return
	fi
	LOADING[$1]=$!
}
loading_close() {
	local pid=${LOADING[$1]:-}
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	unset "LOADING[$1]"
}
shown_number() {  # a joined player's place in the slots file (Player 1 first), as the glue numbers it
	grep -n "^$1 " "$CONTROL/slots" 2>/dev/null | cut -d: -f1 | head -1
}

# --- updates (mcss-update.py) ---
# A newer GitHub release is looked up in the background; Player 1's game offers it (UpdateScreen: installed and new
# version, "Update and Restart" or "Continue without update"). Asked to update (control file "update-request"):
# back up the AppImage as <AppImage>.previous, download and check the new one in its place, then restart into it in
# this same KWin, showing "Restarting". The new version runs as a child of this one: if it doesn't get Minecraft
# started, the backup goes back and this version starts again and says why. If the download fails, the backup goes
# back (if the file was touched) and the game says what went wrong; it keeps running on this version.
# Off with "Updates: Off" in Player 1's Splitscreen settings, --no-update or MCSS_NO_UPDATE=1; skipped for a dev run
# (no $APPIMAGE) or a folder that can't be written.
CURRENT=$(cat "$HERE/VERSION" 2>/dev/null || echo 0.0.0)
update_wanted() {
	[ -n "${APPIMAGE:-}" ] && [ -w "$(dirname "$APPIMAGE")" ] || return 1
	# just updated, or just came back from a failed one: not again this launch
	[ "${MCSS_NO_UPDATE:-}" != 1 ] && [ -z "${MCSS_UPDATED:-}" ] && [ -z "${MCSS_UPDATE_ERROR:-}" ] || return 1
	local a
	for a in "${ARGS[@]}"; do [ "$a" = --no-update ] && return 1; done
	! grep -qx 'updates=off' "$PRISM/instances/P1/minecraft/config/splitscreen.properties" 2>/dev/null
}
update_status() {  # what Player 1's update screen shows: "Downloading v… NN%", "ready", "failed: <why>"
	printf '%s\n' "$1" > "$CONTROL/update-status.tmp" && mv -f "$CONTROL/update-status.tmp" "$CONTROL/update-status"
}
restore_backup() {
	if [ -f "$APPIMAGE.previous" ] && ! cmp -s "$APPIMAGE" "$APPIMAGE.previous"; then
		cp -f "$APPIMAGE.previous" "$APPIMAGE" && log "restored $APPIMAGE from the backup"
	fi
}
update_now() {
	local tag url size sha err
	if [ -z "${APPIMAGE:-}" ] || ! { read -r tag url size sha < "$CONTROL/update-available"; } 2>/dev/null; then
		update_status "failed: no update to install"
		return
	fi
	log "updating $CURRENT -> $tag"
	if ! cp -f "$APPIMAGE" "$APPIMAGE.previous"; then
		update_status "failed: couldn't back up the current version"
		return
	fi
	if ! err=$(MCSS_UPDATE_LABEL="Downloading $tag..." python3 "$HERE/mcss-update.py" download "$url" "$size" "$sha" \
		"$APPIMAGE" "$CONTROL/update-status" 2>&1); then
		restore_backup
		log "update to $tag failed: $err"
		update_status "failed: ${err#update failed: }"
		return
	fi
	log "downloaded $tag, restarting"
	update_status "ready"
	sleep 2   # Player 1's screen says "Restarting"
	restart_into "$tag"
}
restart_into() {  # the new version, in this KWin; this version again if it doesn't get Minecraft started
	local tag=$1 rc n
	trap - EXIT INT TERM HUP
	prism_running && flatpak kill "$PRISM_APP"
	for _ in $(seq 20); do prism_running || break; sleep 0.5; done
	for n in "${!LOADING[@]}"; do loading_close "$n"; done
	echo "Restarting..." > "$STATE/restart-status"
	loading_open 1 1 "$STATE/restart-status"
	rm -f "$STATE/update-ok"
	MCSS_KWIN="$KWIN $SESSION" MCSS_UPDATED=$tag MCSS_RESTART_TILE=${LOADING[1]:-} "$APPIMAGE" "${ARGS[@]}"
	rc=$?
	if [ -e "$STATE/update-ok" ]; then
		log "$tag ran (exit $rc)"
		loading_close 1
		kill "$KWIN" 2>/dev/null
		exit "$rc"
	fi
	log "$tag didn't get Minecraft started (exit $rc): back to $CURRENT"
	restore_backup
	MCSS_KWIN="$KWIN $SESSION" MCSS_RESTART_TILE=${LOADING[1]:-} \
		MCSS_UPDATE_ERROR="Version $tag didn't start, so this is v$CURRENT again." exec "$APPIMAGE" "${ARGS[@]}"
}

# a restart's "Restarting" tile makes way for this launch's own
[ -n "${MCSS_RESTART_TILE:-}" ] && kill "$MCSS_RESTART_TILE" 2>/dev/null
unset MCSS_RESTART_TILE
loading_open 1 1
[ -n "${MCSS_UPDATE_ERROR:-}" ] && printf '%s\n' "$MCSS_UPDATE_ERROR" > "$CONTROL/update-error"
if update_wanted; then
	(python3 "$HERE/mcss-update.py" check "$CURRENT" > "$CONTROL/update-available.tmp" \
		&& mv -f "$CONTROL/update-available.tmp" "$CONTROL/update-available" \
		&& log "update available: $(cut -d' ' -f1 "$CONTROL/update-available")" \
		|| rm -f "$CONTROL/update-available.tmp") &
fi
P1_STARTED=$(date +%s)
prism -l P1 -a "$MSA"
for _ in $(seq 120); do [ -n "$(mc_pid 1)" ] && break; sleep 1; done
[ -n "$(mc_pid 1)" ] || { log "P1 did not start, see $STATE/prism.log"; exit 1; }
log "P1 java pid $(mc_pid 1)"

# --- run the guests P1's lobby has joined (slots: "<player> <join time>"), until P1 quits (that ends the whole
# session, guests included) or KWin goes away ---
declare -A ASKED=()   # player -> the join it was last launched for
declare -A ASKED_AT=()
declare -A SEEN=()    # player -> the join it was seen running for (gone afterwards = the guest quit)
LAST_LAUNCH=0
while kill -0 "$KWIN" 2>/dev/null && [ -n "$(mc_pid 1)" ]; do
	declare -A WANT=()
	while read -r n gen; do [[ "$n" =~ ^[2-4]$ ]] && WANT[$n]=$gen; done 2>/dev/null < "$CONTROL/slots"
	now=$(date +%s)
	if [ -e "$CONTROL/update-request" ]; then
		rm -f "$CONTROL/update-request"
		update_now
	fi
	[ -n "${MCSS_UPDATED:-}" ] && [ -e "$CONTROL/booted" ] && [ ! -e "$STATE/update-ok" ] && touch "$STATE/update-ok"
	# Player 1's loading window: the tiler closes it when the game window appears; this is the fallback
	[ -n "${LOADING[1]:-}" ] && [ $((now - P1_STARTED)) -gt 180 ] && loading_close 1
	for n in 2 3 4; do
		pid=$(mc_pid "$n")
		gen=${WANT[$n]:-}
		if [ -n "$gen" ] && [ -n "$pid" ]; then
			SEEN[$n]=$gen
			# the tiler closes the loading window when the game's shows up; this is the fallback
			[ -n "${LOADING[$n]:-}" ] && [ $((now - ${ASKED_AT[$n]:-0})) -gt 90 ] && loading_close "$n"
		elif [ -n "$gen" ] && [ "${SEEN[$n]:-}" != "$gen" ]; then
			# a new join: one launch at a time (several clients loading at once starve the Deck's 4 cores), and
			# retry if the window hasn't come up after two minutes
			if [ "${ASKED[$n]:-}" != "$gen" ] || [ $((now - ${ASKED_AT[$n]:-0})) -gt 120 ]; then
				if [ $((now - LAST_LAUNCH)) -ge "${MCSS_STAGGER:-8}" ]; then
					log "starting P$n (joined $gen)"
					shown=$(shown_number "$n")
					loading_open "$n" "${shown:-$n}"
					prism -l "P$n" -a "Player$n"
					ASKED[$n]=$gen; ASKED_AT[$n]=$now; LAST_LAUNCH=$now
				fi
			fi
		elif [ -z "$gen" ] && [ -n "$pid" ]; then
			log "stopping P$n (no longer joined), java pid $pid"
			kill "$pid"
		fi
		# left before their game came up, or it never did
		[ -z "$gen" ] && [ -n "${LOADING[$n]:-}" ] && loading_close "$n"
	done
	unset WANT
	sleep 2
done
